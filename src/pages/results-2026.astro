---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import { event, races } from "../data/results2026";

const podium = ["text-amber-500", "text-gray-500 dark:text-gray-300", "text-orange-700 dark:text-orange-400"];
const slug = (title: string) => title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/-$/, "");
---

<Layout title="2026 Results">
  <main class="pt-36 mb-40">
    <Container>
      <div class="text-center">
        <h1 class="text-gray-900 dark:text-white font-bold text-4xl md:text-5xl">
          2026 <span class="text-primary dark:text-white">Results</span>
        </h1>
        <p class="mt-6 text-gray-700 dark:text-gray-300">{event.title}</p>
        <p class="mt-2 text-gray-700 dark:text-gray-300">
          {event.date} · Weather: {event.weather}
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          {races.map((race) => (
            <a
              href={`#${slug(race.title)}`}
              class="px-4 py-2 rounded-full text-sm font-semibold text-primary bg-primary/10 dark:text-white dark:bg-gray-800 hover:scale-105 transition"
            >
              {race.title}
            </a>
          ))}
        </div>
      </div>

      {races.map((race) => (
        <section id={slug(race.title)} class="mt-20 scroll-mt-24">
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">{race.title}</h2>
          {[
            { label: "Women", runners: race.women },
            { label: "Men", runners: race.men },
          ]
            .filter((group) => group.runners.length > 0)
            .map((group) => (
              <div class="mt-6">
                <h3 class="text-lg font-semibold text-gray-700 dark:text-gray-300">{group.label}</h3>
                <div class="mt-3 overflow-x-auto rounded-xl border border-gray-100 dark:border-gray-700">
                  <table class="w-full text-sm text-left text-gray-700 dark:text-gray-300 whitespace-nowrap">
                    <thead class="bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white">
                      <tr>
                        <th class="px-3 py-2">#</th>
                        <th class="px-3 py-2">Bib</th>
                        <th class="px-3 py-2">Name</th>
                        <th class="px-3 py-2">Nat.</th>
                        <th class="px-3 py-2">Born</th>
                        <th class="px-3 py-2">Club</th>
                        {race.splitLabels.map((label) => (
                          <th class="px-3 py-2 text-right">{label}</th>
                        ))}
                        <th class="px-3 py-2 text-right">Time</th>
                      </tr>
                    </thead>
                    <tbody>
                      {group.runners.map((runner) => (
                        <tr class="border-t border-gray-100 dark:border-gray-700">
                          <td class={`px-3 py-2 font-bold ${podium[runner.place - 1] ?? ""}`}>{runner.place}</td>
                          <td class="px-3 py-2">{runner.bib ?? "–"}</td>
                          <td class="px-3 py-2 font-semibold text-gray-900 dark:text-white">
                            {runner.surname} {runner.name}
                          </td>
                          <td class="px-3 py-2">{runner.nationality ?? "–"}</td>
                          <td class="px-3 py-2">{runner.born ?? "–"}</td>
                          <td class="px-3 py-2">{runner.club ?? "–"}</td>
                          {race.splitLabels.map((_, i) => (
                            <td class="px-3 py-2 text-right tabular-nums">{runner.splits[i] ?? "–"}</td>
                          ))}
                          <td class="px-3 py-2 text-right font-bold tabular-nums text-gray-900 dark:text-white">
                            {runner.time}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            ))}
        </section>
      ))}

      <p class="mt-20 text-sm text-gray-500">
        Chief referee: {event.referee} · Results processed by: {event.processedBy}
      </p>
    </Container>
  </main>
</Layout>
